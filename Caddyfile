# Caddy uses Cloudflare DNS-01 challenge for cert provisioning.
# This means Let's Encrypt validates ownership via a DNS TXT record (placed
# automatically by Caddy via the Cloudflare API), NOT via HTTP on port 80.
# Result: certs work even though port 80 is closed to the public internet.
#
# Replace `kxmacro.com` with your real domain (4 places). The CLOUDFLARE_API_TOKEN
# env var must be set in .env (a token with "Zone:DNS:Edit" permission for the zone).
{
    email admin@kxmacro.com
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

liquidity.kxmacro.com {
    reverse_proxy liquidity:8050
    encode zstd gzip
    log {
        output file /data/access-liquidity.log
        format console
    }
}

growth.kxmacro.com {
    reverse_proxy growth:8051
    encode zstd gzip
    log {
        output file /data/access-growth.log
        format console
    }
}

inflation.kxmacro.com {
    reverse_proxy inflation:8052
    encode zstd gzip
    log {
        output file /data/access-inflation.log
        format console
    }
}

seasonality.kxmacro.com {
    reverse_proxy seasonality:8501
    encode zstd gzip
    # Streamlit needs websocket pass-through (Caddy does this by default)
    log {
        output file /data/access-seasonality.log
        format console
    }
}
