# Copy to .env and fill in. NEVER commit .env to git.
# `docker compose ...` picks this up automatically when named .env.

# ---- Postgres ----
POSTGRES_USER=kx
POSTGRES_PASSWORD=CHANGE_ME_to_something_random_and_long
POSTGRES_DB=macro

# ---- Tailscale (REQUIRED) ----
# Generate at: https://login.tailscale.com/admin/settings/keys
# IMPORTANT: must be REUSABLE (so multiple sidecars can authenticate with it)
# and NON-EPHEMERAL (so containers keep their identity across restarts).
# Recommended expiry: 90 days. Re-run `docker compose up -d` after rotating.
TS_AUTHKEY=

# ---- GitHub access (only needed if your dashboard repos are private
#       AND your droplet's SSH key isn't on your GitHub account) ----
# Generate at https://github.com/settings/tokens
# Classic token with `repo` scope, OR fine-grained scoped to your 4 repos with read access.
GITHUB_TOKEN=

# ---- Free data ----
FRED_API_KEY=                    # Optional — higher rate limits with a key

# ---- Paid data feeds (when you subscribe) ----
DATABENTO_API_KEY=               # momentum screener: roll-adjusted continuous futures (else yfinance fallback)
EODHD_API_KEY=
TRUFLATION_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=
QUIVER_API_KEY=
GLASSNODE_API_KEY=

# ---- Bloomberg (when whitelisted) ----
BLOOMBERG_HOST=                  # B-PIPE endpoint or "localhost" for SAPI on this host
BLOOMBERG_PORT=8194

# ---- Polymarket smart-money mirror ----
# LLM classifier (optional; keyword-only classification works without it)
ANTHROPIC_API_KEY=
LLM_CLASSIFIER_MODEL=claude-haiku-4-5
# Telegram push alerts (optional; alerts still land in dashboard Alert Log without these)
# Create bot via @BotFather on Telegram; send /start to bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tuning knobs (defaults are sane; override only if you want to tweak)
SMART_MONEY_MIN_CLOSED_MARKETS=10
WATCHLIST_TOP_N_PER_CLUSTER=20
WATCHLIST_LOOKBACK_DAYS=90
ALERT_SIZE_THRESHOLD_USD=10000
ALERT_CLUSTER_M=3
ALERT_CLUSTER_WINDOW_HOURS=24
WATCHLIST_POLL_INTERVAL_MIN=10
DAILY_BATCH_HOUR_UTC=6

# ---- G10 Central Bank Intelligence ----
G10_CB_INTEL_PORT=8067
G10_CB_INTEL_WORKERS=2
