# Copy to .env and fill in. NEVER commit .env to git.
# `docker compose ... ` picks this up automatically when named .env.

# ---- Postgres ----
POSTGRES_USER=kx
POSTGRES_PASSWORD=CHANGE_ME_to_something_random_and_long
POSTGRES_DB=macro

# ---- Cloudflare (REQUIRED for HTTPS cert provisioning) ----
# Token with permissions: Zone:DNS:Edit on your specific domain.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Use template "Edit zone DNS" and limit to your kxmacro.com zone.
CLOUDFLARE_API_TOKEN=

# ---- Tailscale ----
# Used by bootstrap.sh, not by the running stack. Generate at:
# https://login.tailscale.com/admin/settings/keys
# (also possible: leave blank and authenticate interactively)
TS_AUTHKEY=

# ---- Free data ----
FRED_API_KEY=                    # Optional — higher rate limits with a key

# ---- Paid data feeds (when you subscribe) ----
EODHD_API_KEY=
TRUFLATION_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=
QUIVER_API_KEY=
GLASSNODE_API_KEY=

# ---- Bloomberg (when whitelisted) ----
BLOOMBERG_HOST=                  # B-PIPE endpoint or "localhost" for SAPI on this host
BLOOMBERG_PORT=8194
